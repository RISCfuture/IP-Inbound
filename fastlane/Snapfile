# A list of devices you want to take the screenshots from
devices [
  # iPhone categories
  "iPhone 15 Pro Max",      # 6.9" display
  "iPhone 14 Plus",         # 6.5" display
  "iPhone 15 Pro",          # 6.3" display
  "iPhone 14",              # 6.1" display
  # "iPhone 8 Plus",          # 5.5" display - Not compatible with iOS 26 (A11 chip)
  "iPhone SE (3rd generation)", # 4.7" display

  # iPad categories
  "iPad Pro 13-inch (M4)",      # 13" display
  "iPad Pro (12.9-inch) (6th generation)", # 12.9" display
  "iPad Pro 11-inch (M4)",      # 11" display
  "iPad Air (5th generation)",  # 10.5" display
  "iPad (9th generation)"       # 9.7" display
]

# Languages to generate screenshots for
languages [
  "en-US"
]

# The name of the scheme which contains the UI Tests
scheme "Generate Screenshots"

# Where should the resulting screenshots be stored?
output_directory "./fastlane/screenshots"

# Clear all previously generated screenshots before creating new ones
clear_previous_screenshots true

# Enable to reinstall the app before running the tests
reinstall_app true

# Enable to erase the simulator before running the tests
erase_simulator true

# Override status bar to show 9:41 AM, full battery and reception
override_status_bar false

# Stop after first error
stop_after_first_error false

# Number of retries if a test fails
number_of_retries 5

# Test without building (requires a derived data path)
test_without_building false

# Configuration for dark mode - this will run tests twice, once for light and once for dark
# Dark mode configuration
dark_mode true

# Launch arguments to pass to the app on launch
launch_arguments [
  "-UITestsEnabled YES"
]

# The bundle identifier of your app
app_identifier "codes.tim.IP-Inbound"

# Disable concurrent simulators to avoid resource contention
concurrent_simulators false

output_simulator_logs true
result_bundle true
