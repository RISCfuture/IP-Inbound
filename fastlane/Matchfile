git_url("git@github.com:RISCfuture/certificates.git")
storage_mode("git")

# The certificates repository keeps every app's certificates and profiles on `main`, and it is not
# the branch match reaches for: its git_branch defaults to "master". A branch that does not exist is
# not an error to match — it starts an empty one — and a `master` that another match run pushed
# holds only that run's profiles, so a read-only sync fails to find this app's.
git_branch("main")

type("appstore")
team_id("2NFSK2WB24")

# App Store profiles are stored alongside the certificate, because `exportArchive` cannot obtain one
# on its own — cloud signing is refused for distribution. The archive still signs automatically, so
# the project stays on automatic signing for local development; only the export consumes these
# profiles, which build_app wires into its export options from match’s mapping.
# The watch app, its complication and the Live Activity extension are signed separately inside
# the iOS archive.
app_identifier([
  "codes.tim.IP-Inbound",
  "codes.tim.IP-Inbound.watchkitapp",
  "codes.tim.IP-Inbound.Live-Activity",
  "codes.tim.IP-Inbound.watchkitapp.TOTComplication",
])
