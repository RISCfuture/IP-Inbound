DEFINE SCHEMA

    RECORD TYPE CD_Target (
        CD__offsetBearing      DOUBLE QUERYABLE SORTABLE,
        CD_declination         DOUBLE QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id_ckAsset          ASSET,
        CD_isConfigured        INT64 QUERYABLE SORTABLE,
        CD_latitude            DOUBLE QUERYABLE SORTABLE,
        CD_longitude           DOUBLE QUERYABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset        ASSET,
        CD_offsetBearingIsTrue INT64 QUERYABLE SORTABLE,
        CD_offsetDistance      DOUBLE QUERYABLE SORTABLE,
        CD_offsetTime          DOUBLE QUERYABLE SORTABLE,
        CD_targetGroundSpeed   DOUBLE QUERYABLE SORTABLE,
        CD_timeOnTarget        TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
